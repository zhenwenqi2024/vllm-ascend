+Result HybmHostShmSegment::MapDevice(void *address, uint64_t size, uint64_t &deviceVa) noexcept
+{
+    if (!(options_.dataOpType & HYBM_DOP_TYPE_MTE) || size == 0) {
+        return BM_OK;
+    }
+    void *dva = nullptr;
+    auto ret = DlHalApi::HalHostRegister(address, size, HOST_MEM_MAP_DEV, logicDeviceId_, &dva);
+    if (ret != BM_OK) {
+        BM_LOG_ERROR("SHM device mapping failed: " << ret << " address:" << address);
+        return ret;
+    }
+    deviceVa = reinterpret_cast<uint64_t>(dva);
+    deviceMappings_.emplace(reinterpret_cast<uint64_t>(address), size);
+    return BM_OK;
+}
+
+void HybmHostShmSegment::UnmapDevice(uint64_t address) noexcept
+{
+    auto it = deviceMappings_.find(address);
+    if (it == deviceMappings_.end()) {
+        return;
+    }
+    auto ret = DlHalApi::HalHostUnregisterEx(reinterpret_cast<void *>(address), logicDeviceId_, HOST_MEM_MAP_DEV);
+    if (ret != BM_OK) {
+        BM_LOG_ERROR("SHM device unmapping failed: " << ret << " address:" << VaToStr(address));
+    }
+    deviceMappings_.erase(it);
+}
